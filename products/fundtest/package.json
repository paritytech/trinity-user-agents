{
  "name": "fundtest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reference funding provider for Paseo Next v2: a simulated fiat leg in front of the real on-chain route to CASH",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "postinstall": "bash scripts/fetch-getcash.sh",
    "build": "npm run build:app && npm run build:worker",
    "build:app": "vite build --config vite.config.app.ts",
    "build:worker": "vite build --config vite.config.worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --isolate ./test"
  },
  "dependencies": {
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@parity/product-sdk-host": "0.25.0",
    "@parity/truapi": "file:../../js/packages/truapi",
    "@polkadot-labs/hdkd": "^0.0.26",
    "@polkadot-labs/hdkd-helpers": "^0.0.27",
    "@scure/base": "^2.3.0",
    "@scure/sr25519": "1.0.0",
    "polkadot-api": "2.2.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  },
  "overrides": {
    "@parity/truapi": "$@parity/truapi",
    "@polkadot-api/json-rpc-provider": "0.2.0"
  }
}
