{
  "sourceLanguage": "en",
  "strings": {
    "autoHidden.message": {
      "comment": "Message of the Docklet tip beside the Edge glow, shown when the bar first tucks itself away",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It hides when you're not using it. Drag it in from the glow"
          }
        }
      }
    },
    "autoHidden.title": {
      "comment": "Title of the Docklet tip beside the Edge glow, shown when the bar first tucks itself away",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Docklet tucked itself away"
          }
        }
      }
    },
    "chainStatus.message": {
      "comment": "Message of the tip pointing at the chain status strip",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These rings track your connection to each chain."
          }
        }
      }
    },
    "chainStatus.title": {
      "comment": "Title of the tip pointing at the chain status strip",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network status"
          }
        }
      }
    },
    "scan.message": {
      "comment": "Message of the tab bar tip pointing at the scan action",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan to pay or add a contact."
          }
        }
      }
    },
    "scan.title": {
      "comment": "Title of the tab bar tip pointing at the scan action",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan a QR code"
          }
        }
      }
    },
    "tucked.message": {
      "comment": "Message of the Docklet tip beside the Edge glow, shown on the first swipe tuck",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag in from the right edge"
          }
        }
      }
    },
    "tucked.title": {
      "comment": "Title of the Docklet tip beside the Edge glow, shown on the first swipe tuck",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your dock is tucked away"
          }
        }
      }
