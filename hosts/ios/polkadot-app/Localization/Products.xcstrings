        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que este producto comparta una referencia a tu perfil con todos tus contactos de Chat. Los contactos que la reciban podrán leer tu perfil."
          }
        }
      }
    },
    "permission.body.chatAuthority": {
      "extractionState": "manual",
      "localizations": {
