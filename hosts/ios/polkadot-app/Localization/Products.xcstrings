    "permission.body.profileDisclosure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows this product to share a reference to your profile with every Chat contact. Contacts who receive it can read your profile."
