{
  "name": "truapi-web-signing-host",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Standalone browser TrUAPI host that holds a development wallet and signs locally, with no companion app or QR pairing",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test src scripts --timeout 60000",
    "test:browser": "bun test browser --timeout 180000",
    "test:sandbox": "bun src/sandbox/e2e/boundary.e2e.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@parity/truapi": "file:../../js/packages/truapi",
    "@parity/truapi-debugger": "file:../../js/packages/truapi-debugger",
    "@parity/truapi-host": "file:../../js/packages/truapi-host",
    "@parity/truapi-provider": "file:../../js/packages/truapi-provider",
    "@scure/bip39": "^2.0.0",
    "neverthrow": "^8.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.16"
  }
}
