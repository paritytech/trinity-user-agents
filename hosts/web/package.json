{
  "name": "truapi-web-host",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Standalone browser TrUAPI host that holds a development wallet and signs locally, with no companion app or QR pairing",
  "scripts": {
    "dev": "vite",
    "dev:field-provider": "vite --config field-products.config.ts --port 5182",
    "dev:field-provider-2": "VITE_FIELD_PROVIDER_NAME='Travel notebook' vite --config field-products.config.ts --port 5185",
    "dev:field-market": "vite --config field-products.config.ts --port 5183",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./tests/unit --timeout 60000",
    "test:browser": "bun test ./browser --timeout 180000",
    "build:kettle": "CARGO_TARGET_DIR=\"$PWD/../../target/kettle-chat-wasm\" wasm-pack build apps/kettle-chat/wasm --target web --release --no-typescript --no-pack --out-dir pkg --out-name kettle_chat"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.2.0",
    "@noble/post-quantum": "^0.7.1",
    "@parity/truapi": "file:../../js/packages/truapi",
    "@parity/truapi-debugger": "file:../../js/packages/truapi-debugger",
    "@parity/truapi-host": "file:../../js/packages/truapi-host",
    "@parity/truapi-provider": "file:../../js/packages/truapi-provider",
    "@scure/bip39": "^2.0.0",
    "@scure/sr25519": "^2.4.0",
    "neverthrow": "^8.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.16"
  }
}
