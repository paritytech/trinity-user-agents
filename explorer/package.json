{
  "name": "truapi-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run generate-matrix",
    "dev": "vite",
    "prebuild": "npm run generate-matrix",
    "build": "tsc -b && vite build",
    "prelint": "npm run generate-matrix",
    "lint": "tsc -b --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "preview": "vite preview",
    "generate-matrix": "node scripts/aggregate-diagnosis-matrix.mjs --explorer-out src/data/compatibility.ts diagnosis-reports"
  },
  "dependencies": {
    "@parity/truapi": "file:../js/packages/truapi",
    "lucide-react": "^0.577.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.6.0",
    "vite": "^8.3.4"
  }
}
