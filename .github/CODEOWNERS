# Reviewers requested from the paths a pull request touches.
#
# The same roots drive labelling in .github/labeler.yml. The two are different
# formats and cannot be one file, so scripts/check-path-routing.py holds them to
# the same set and CI runs it.
#
# This requests a review. It does not gate one: the branch ruleset already
# requires a team review on every file, so an entry here decides who is asked,
# not whether anyone is.

# Everything, so no path is left without an owner. Later entries win, so a more
# specific line below overrides this one.
*                       @paritytech/host-sdk-team

# The shared core. A change here reaches every host at once, which is why it is
# named separately even though it resolves to the same reviewers today.
/rust/crates/           @paritytech/host-sdk-team

# The hosts, kept apart from each other rather than treated as one area.
/hosts/ios/             @paritytech/host-sdk-team
/ios/                   @paritytech/host-sdk-team
/hosts/android/         @paritytech/host-sdk-team
/android/               @paritytech/host-sdk-team

# The client, the playground and the explorer.
/js/                    @paritytech/host-sdk-team
/playground/            @paritytech/host-sdk-team
/explorer/              @paritytech/host-sdk-team

# The pipelines themselves. A change here can alter what every other gate does,
# including the ones that would otherwise catch it.
/.github/workflows/     @paritytech/host-sdk-team
/.github/actions/       @paritytech/host-sdk-team

# Documents and proposals.
/docs/                  @paritytech/host-sdk-team
