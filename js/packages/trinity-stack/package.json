{
  "name": "@parity/trinity-stack",
  "version": "0.0.0",
  "description": "Read, verify, sign and publish Trinity stack descriptors; the rules run in the trinity-stack Rust crate compiled to WebAssembly",
  "license": "MIT",
  "author": "Parity Technologies <admin@parity.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paritytech/trinity-user-agents.git",
    "directory": "js/packages/trinity-stack"
  },
  "homepage": "https://github.com/paritytech/trinity-user-agents#readme",
  "bugs": {
    "url": "https://github.com/paritytech/trinity-user-agents/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "wasm",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.3"
  },
  "scripts": {
    "build": "npm run build:wasm && tsc -b",
    "build:wasm": "node scripts/build-wasm.mjs",
    "typecheck": "tsc -b",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "bun test",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.mjs\" README.md",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.mjs\" README.md"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^6.0"
  }
}
