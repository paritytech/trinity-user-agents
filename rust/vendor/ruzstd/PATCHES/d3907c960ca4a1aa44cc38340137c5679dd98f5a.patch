From d3907c960ca4a1aa44cc38340137c5679dd98f5a Mon Sep 17 00:00:00 2001
From: Moritz Borcherding <moritz.borcherding@web.de>
Date: Sun, 11 Oct 2026 14:52:31 +0200
Subject: [PATCH] assert that a block will not generate more decoded bytes than
 the maximum would allow

---
 ruzstd/src/decoding/block_decoder.rs      | 17 +++++++++++++++--
 ruzstd/src/decoding/errors.rs             | 14 ++++++++++++++
 ruzstd/src/decoding/sequence_execution.rs | 12 +++++++++++-
 3 files changed, 40 insertions(+), 3 deletions(-)

diff --git a/ruzstd/src/decoding/block_decoder.rs b/ruzstd/src/decoding/block_decoder.rs
index 66b9204c2..d3b159ae1 100644
--- a/ruzstd/src/decoding/block_decoder.rs
+++ b/ruzstd/src/decoding/block_decoder.rs
@@ -50,6 +50,11 @@ impl BlockDecoder {
             }
         }
 
+        // Block_Maximum_Size (RFC 8878 3.1.1.2.4): the smaller of the window and 128 KiB
+        let max_block_len = (workspace.buffer.window_size).min(MAX_BLOCK_SIZE as usize);
+        // raw and RLE blocks state their size, compressed ones are checked as they decode
+        Self::check_decompressed_size(header.decompressed_size as usize, max_block_len)?;
+
         let block_type = header.block_type;
         match block_type {
             BlockType::RLE => {
@@ -86,7 +91,7 @@ impl BlockDecoder {
             }
 
             BlockType::Compressed => {
-                self.decompress_block(header, workspace, source)?;
+                self.decompress_block(header, workspace, source, max_block_len)?;
 
                 self.internal_state = DecoderState::ReadyToDecodeNextHeader;
                 Ok(u64::from(header.content_size))
@@ -94,11 +99,19 @@ impl BlockDecoder {
         }
     }
 
+    fn check_decompressed_size(at_least: usize, max: usize) -> Result<(), DecompressBlockError> {
+        if at_least > max {
+            return Err(DecompressBlockError::DecompressedSizeTooLarge { at_least, max });
+        }
+        Ok(())
+    }
+
     fn decompress_block(
         &mut self,
         header: &BlockHeader,
         workspace: &mut DecoderScratch, //reuse this as often as possible. Not only if the trees are reused but also reuse the allocations when building new trees
         mut source: impl Read,
+        max_block_decoded_len: usize,
     ) -> Result<(), DecompressBlockError> {
         workspace
             .block_content_buffer
@@ -180,7 +193,7 @@ impl BlockDecoder {
                 &mut workspace.sequences,
             )?;
             vprintln!("Executing sequences");
-            execute_sequences(workspace)?;
+            execute_sequences(workspace, max_block_decoded_len)?;
         } else {
             if !raw.is_empty() {
                 return Err(DecompressBlockError::DecodeSequenceError(
diff --git a/ruzstd/src/decoding/errors.rs b/ruzstd/src/decoding/errors.rs
index 5f271c209..a86dd4a36 100644
--- a/ruzstd/src/decoding/errors.rs
+++ b/ruzstd/src/decoding/errors.rs
@@ -259,6 +259,10 @@ pub enum DecompressBlockError {
         expected_len: usize,
         remaining_bytes: usize,
     },
+    DecompressedSizeTooLarge {
+        max: usize,
+        at_least: usize,
+    },
     DecompressLiteralsError(DecompressLiteralsError),
     LiteralsSectionParseError(LiteralsSectionParseError),
     SequencesHeaderParseError(SequencesHeaderParseError),
@@ -295,6 +299,9 @@ impl core::fmt::Display for DecompressBlockError {
                     "Malformed section header. Says literals would be this long: {expected_len} but there are only {remaining_bytes} bytes left",
                 )
             }
+            DecompressBlockError::DecompressedSizeTooLarge { max, at_least } => {
+                write!(f, "Malformed block wanted to generate {at_least} bytes of decompressed content, maximun is: {max}")
+            }
             DecompressBlockError::DecompressLiteralsError(e) => write!(f, "{e:?}"),
             DecompressBlockError::LiteralsSectionParseError(e) => write!(f, "{e:?}"),
             DecompressBlockError::SequencesHeaderParseError(e) => write!(f, "{e:?}"),
@@ -683,6 +690,7 @@ impl From<HuffmanTableError> for DecompressLiteralsError {
 pub enum ExecuteSequencesError {
     DecodebufferError(DecodeBufferError),
     NotEnoughBytesForSequence { wanted: usize, have: usize },
+    TooManyBytesGenerated { max: usize, decoded: usize },
     ZeroOffset,
 }
 
@@ -698,6 +706,12 @@ impl core::fmt::Display for ExecuteSequencesError {
                     "Sequence wants to copy up to byte {wanted}. Bytes in literalsbuffer: {have}"
                 )
             }
+            ExecuteSequencesError::TooManyBytesGenerated { max, decoded } => {
+                write!(
+                    f,
+                    "Executing sequences produced more decoded bytes than allowed for one block: {decoded}, maximum is: {max}"
+                )
+            }
             ExecuteSequencesError::ZeroOffset => {
                 write!(f, "Illegal offset: 0 found")
             }
diff --git a/ruzstd/src/decoding/sequence_execution.rs b/ruzstd/src/decoding/sequence_execution.rs
index 8ddcf0b09..43653e441 100644
--- a/ruzstd/src/decoding/sequence_execution.rs
+++ b/ruzstd/src/decoding/sequence_execution.rs
@@ -2,7 +2,10 @@ use super::scratch::DecoderScratch;
 use crate::decoding::errors::ExecuteSequencesError;
 
 /// Take the provided decoder and execute the sequences stored within
-pub fn execute_sequences(scratch: &mut DecoderScratch) -> Result<(), ExecuteSequencesError> {
+pub fn execute_sequences(
+    scratch: &mut DecoderScratch,
+    max_block_decoded_len: usize,
+) -> Result<(), ExecuteSequencesError> {
     let mut literals_copy_counter = 0;
     let old_buffer_size = scratch.buffer.len();
     let mut seq_sum = 0;
@@ -36,6 +39,13 @@ pub fn execute_sequences(scratch: &mut DecoderScratch) -> Result<(), ExecuteSequ
 
         seq_sum += seq.ml;
         seq_sum += seq.ll;
+
+        if seq_sum as usize > max_block_decoded_len {
+            return Err(ExecuteSequencesError::TooManyBytesGenerated {
+                max: max_block_decoded_len,
+                decoded: seq_sum as usize,
+            });
+        }
     }
     if literals_copy_counter < scratch.literals_buffer.len() {
         let rest_literals = &scratch.literals_buffer[literals_copy_counter..];
